{
  "name": "super-fight-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "framedata": "node scripts/framedata.mjs",
    "artifact": "npm run build && node scripts/make-artifact.mjs",
    "smoke": "node tests/e2e/smoke.mjs",
    "ci": "tsc --noEmit -p . && vitest run && vite build && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
